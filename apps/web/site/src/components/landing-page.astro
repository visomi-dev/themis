---
import type { Locale } from '../content/site-content';
import LocaleSwitcher from './locale-switcher.astro';
import ThemeSwitcher from './theme-switcher.astro';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const appHref = locale === 'en' ? '/app/en/' : '/app/es/';

const content =
  locale === 'en'
    ? {
        title: 'Themis | AI-Integrated Technical Ledger',
        heroTitle: 'Clarity for complex execution, powered by AI context.',
        heroBody:
          'Themis is a technical ledger designed for teams where AI agents and human developers co-author the roadmap. Bridge the gap between code generation and architectural intent.',
        headerCta: 'Get Started',
        heroPrimary: 'Request Access',
        heroSecondary: 'Read Methodology',
        overviewLabel: 'Unified briefing for Human & AI Agent workstreams',
        projectAlphaBody: 'System-wide migration. Agent 0x42 is currently mapping dependencies.',
        projectAlphaAgent: 'Agent 0x42',
        infrastructureBody: 'Provisioning new GPU clusters in the Western Node.',
        infrastructureStatus: 'Stale',
        infrastructureNote: 'Awaiting agent validation of hardware allocation',
        insightsTitle: 'Agent Insights',
        insightsItems: ['Logic Loop Detected: Neural Edge', 'Auto-refactoring: API Rate Limiter'],
        decisionsTitle: 'Recent Decisions',
        decisions: ['Agent suggested Project Alpha schema transition.', 'Lead approved Agent 0x88 refactor plan.'],
        valueTitles: ['Shared Context.', 'AI-Assisted Scoping.', 'Visual Agent Reports.'],
        valueBodies: [
          'One source of truth for humans and AI agents. No more context switching or "re-explaining" the goal to your LLM.',
          'Agents generate technical visuals, dependency maps, and spec drafts directly within the task ledger.',
          'See visual progress reports from code agents. High-signal updates that show exactly what changed in the codebase.',
        ],
        contextWindow: 'AI Context Window',
        detailTitle: 'Agent Insights: Pushed to the plan.',
        detailBody:
          "Most tools bury technical context. Themis allows code agents to push architecture diagrams, security benchmarks, and implementation visuals directly into the developer's workspace.",
        detailFeatures: ['Agent-Generated Architectural Visuals', 'Direct Agent Feedback and Decision Logs'],
        taskTitle: 'API Rate Limiter Implementation',
        taskBody:
          'Implement token bucket algorithm. Agent 0x9 has drafted the spec and identified a race condition in the edge gateway.',
        taskAgent: 'Agent 0x9',
        taskPrimary: 'Agent Flow Diagram',
        taskPrimaryAction: 'VIEW VISUAL',
        taskSecondary: 'AI Security Audit',
        taskSecondaryAction: 'Passed',
        systemTitle: 'Engineered for teams that leverage AI.',
        systemCards: [
          {
            title: 'Agent-Readable State',
            body: 'We use a highly structured relational ledger that allows AI agents to understand project context as clearly as a developer does. No more "forgetful" assistants.',
          },
          {
            title: 'Sync with Execution',
            body: 'When your agent updates code, Themis updates the plan. Maintain structural integrity across complex dependency trees with automated status syncing.',
          },
        ],
        closingTitle: 'Ready for structural clarity?',
        closingBody: 'Join technical leads who prioritize AI-integrated execution over noise.',
        closingPrimary: 'Get Started',
        closingSecondary: 'Request Access',
        footerLinks: ['Documentation', 'System Status', 'Privacy', 'Terms'],
      }
    : {
        title: 'Themis | Ledger técnico con IA integrada',
        heroTitle: 'Claridad para ejecutar sistemas complejos, con contexto compartido para IA.',
        heroBody:
          'Themis es un ledger técnico para equipos donde agentes de IA y developers trabajan sobre el mismo contexto operativo. Reduce la distancia entre la generación de código y la intención arquitectónica.',
        headerCta: 'Empezar',
        heroPrimary: 'Solicitar acceso',
        heroSecondary: 'Ver metodología',
        overviewLabel: 'Lectura unificada para flujos de trabajo humanos y agentes de IA',
        projectAlphaBody: 'Migración completa del sistema. El agente 0x42 está mapeando dependencias.',
        projectAlphaAgent: 'agente 0x42',
        infrastructureBody: 'Provisionando nuevos clusters GPU en el nodo occidental.',
        infrastructureStatus: 'Estancado',
        infrastructureNote: 'Pendiente de validación del agente sobre la asignación de hardware',
        insightsTitle: 'Señales de agentes',
        insightsItems: ['Bucle lógico detectado: Neural Edge', 'Refactor automático: API Rate Limiter'],
        decisionsTitle: 'Decisiones recientes',
        decisions: [
          'El agente propuso la transición de esquema para Project Alpha.',
          'La persona responsable aprobó el plan de refactor del agente 0x88.',
        ],
        valueTitles: ['Contexto compartido.', 'Alcance asistido por IA.', 'Reportes visuales de agentes.'],
        valueBodies: [
          'Una sola fuente de verdad para personas y agentes de IA. Menos cambio de contexto y menos necesidad de volver a explicar el objetivo al modelo.',
          'Los agentes generan visuales técnicos, mapas de dependencias y borradores de especificación directamente dentro del ledger.',
          'Consulta reportes visuales de progreso generados por agentes de código. Actualizaciones de alta señal sobre lo que cambió en el repositorio.',
        ],
        contextWindow: 'Ventana de contexto IA',
        detailTitle: 'Señales de agentes, incorporadas al plan.',
        detailBody:
          'La mayoría de herramientas esconden el contexto técnico. Themis permite que los agentes publiquen diagramas de arquitectura, validaciones de seguridad y visuales de implementación directamente en el espacio de trabajo.',
        detailFeatures: [
          'Visuales de arquitectura generados por agentes',
          'Feedback directo de agentes y registro de decisiones',
        ],
        taskTitle: 'Implementación de API Rate Limiter',
        taskBody:
          'Implementar el algoritmo token bucket. El agente 0x9 ya redactó la especificación e identificó una condición de carrera en el gateway perimetral.',
        taskAgent: 'agente 0x9',
        taskPrimary: 'Diagrama de flujo del agente',
        taskPrimaryAction: 'VER VISUAL',
        taskSecondary: 'Auditoría de seguridad IA',
        taskSecondaryAction: 'Aprobada',
        systemTitle: 'Diseñado para equipos que integran IA de forma real.',
        systemCards: [
          {
            title: 'Estado legible por agentes',
            body: 'Usamos un ledger relacional altamente estructurado para que los agentes de IA entiendan el contexto del proyecto con la misma claridad que una persona del equipo. Menos asistentes olvidadizos, más continuidad operativa.',
          },
          {
            title: 'Sincronizado con la ejecución',
            body: 'Cuando un agente actualiza código, Themis actualiza el plan. Así mantiene la integridad estructural en árboles de dependencias complejos con sincronización automática del estado.',
          },
        ],
        closingTitle: '¿Listo para trabajar con claridad estructural?',
        closingBody:
          'Únete a equipos técnicos que priorizan ejecución integrada con IA por encima del ruido operativo.',
        closingPrimary: 'Empezar',
        closingSecondary: 'Solicitar acceso',
        footerLinks: ['Documentación', 'Estado del sistema', 'Privacidad', 'Términos'],
      };

const splitHighlightedText = (text: string, highlightedText: string) => {
  const [before, after = ''] = text.split(highlightedText);

  return { after, before };
};

const projectAlphaBodyParts = splitHighlightedText(content.projectAlphaBody, content.projectAlphaAgent);
const taskBodyParts = splitHighlightedText(content.taskBody, content.taskAgent);
const decisionHighlight = 'Project Alpha';
const firstDecisionParts = splitHighlightedText(content.decisions[0], decisionHighlight);
---

<main>
  <nav
    class="sticky top-0 z-50 mx-auto flex w-full max-w-screen-2xl items-center justify-between border-b border-zinc-950/10 bg-white/80 px-4 py-3 backdrop-blur-md transition-colors duration-200 ease-in-out md:px-12 dark:border-white/10 dark:bg-zinc-950/80"
  >
    <div class="font-heading text-xl font-bold tracking-tighter text-blue-600 uppercase dark:text-zinc-50">Themis</div>
    <div class="flex items-center gap-8">
      <div class="flex items-center gap-8">
        <LocaleSwitcher locale={locale} />
        <ThemeSwitcher />
      </div>
      <a
        href={appHref}
        class="rounded-lg bg-blue-600 px-6 py-2 text-sm font-semibold text-white transition-all hover:bg-blue-700 active:scale-95 dark:bg-blue-500 dark:font-bold dark:hover:bg-blue-400"
        >{content.headerCta}</a
      >
    </div>
  </nav>

  <section
    class="mx-auto flex min-h-dvh max-w-screen-2xl flex-col items-center justify-center px-4 py-6 text-center md:px-12 md:py-8"
  >
    <h1
      class="font-heading mb-4 max-w-5xl text-4xl leading-none font-extrabold tracking-tighter text-zinc-950 md:text-6xl lg:text-8xl dark:text-zinc-50"
    >
      {content.heroTitle}
    </h1>
    <p class="mb-6 max-w-2xl text-base leading-relaxed font-light text-zinc-500 md:text-xl dark:text-zinc-400">
      {content.heroBody}
    </p>
    <div class="flex flex-col gap-3 sm:flex-row md:gap-4">
      <a
        href={appHref}
        class="w-full rounded-lg bg-blue-600 px-6 py-2.5 text-center font-semibold text-white transition-all hover:bg-blue-700 sm:w-auto md:px-8 md:py-3 md:font-bold dark:bg-blue-500 dark:hover:bg-blue-400"
        >{content.heroPrimary}</a
      >
      <a
        href="#methodology"
        class="w-full rounded-lg border border-zinc-950/20 px-6 py-2.5 text-center font-semibold text-zinc-950 transition-colors hover:bg-zinc-100 sm:w-auto md:px-8 md:py-3 md:font-bold dark:border-white/20 dark:text-zinc-50 dark:hover:bg-zinc-800"
        >{content.heroSecondary}</a
      >
    </div>
  </section>

  <section class="mx-auto mb-8 max-w-screen-2xl px-4 md:mb-16 md:px-12">
    <div
      class="overflow-hidden rounded-xl border border-zinc-950/10 bg-white shadow-2xl dark:border-white/10 dark:bg-zinc-900"
    >
      <div class="bg-zinc-50 p-4 md:p-8 dark:bg-zinc-900/50">
        <div class="mb-5 flex items-center justify-between">
          <div>
            <h3 class="font-heading text-2xl font-extrabold text-zinc-950 dark:text-zinc-50">Projects Overview</h3>
            <p class="mt-1 text-xs font-bold tracking-widest text-zinc-500 uppercase dark:text-zinc-400">
              {content.overviewLabel}
            </p>
          </div>
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-zinc-500 dark:text-zinc-400">search</span>
            <div
              class="flex items-center gap-2 rounded-sm border border-blue-600/30 bg-blue-600/20 px-3 py-1 dark:border-blue-400/30 dark:bg-blue-400/20"
            >
              <span class="material-symbols-outlined text-sm text-blue-600 dark:text-blue-400">smart_toy</span>
              <span class="text-xs font-bold tracking-tighter text-blue-600 uppercase dark:text-blue-400"
                >4 Agents Active</span
              >
            </div>
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-600/10 dark:bg-zinc-700">
              <span class="material-symbols-outlined text-sm text-blue-600 dark:text-blue-400">person</span>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-4 md:gap-6 lg:grid-cols-3">
          <div class="space-y-4 lg:col-span-2">
            <div
              class="rounded border border-l-4 border-blue-600 border-zinc-950/10 bg-white p-4 shadow-sm md:p-6 dark:border-zinc-700 dark:bg-zinc-900"
            >
              <div class="mb-4 flex items-start justify-between">
                <div>
                  <h4 class="font-heading text-lg font-bold text-zinc-950 dark:text-zinc-50">Project Alpha</h4>
                  <p class="text-sm text-zinc-500 dark:text-zinc-400">
                    {projectAlphaBodyParts.before}<span class="font-medium text-blue-600 dark:text-blue-400"
                      >{content.projectAlphaAgent}</span
                    >{projectAlphaBodyParts.after}
                  </p>
                </div>
                <span
                  class="rounded bg-green-100 px-2 py-0.5 text-xs font-black text-green-700 uppercase dark:bg-green-500/20 dark:tracking-wider dark:text-green-300"
                  >Active</span
                >
              </div>
              <div class="space-y-2">
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-700/30">
                  <div class="h-full w-3/4 bg-blue-600 dark:bg-blue-500"></div>
                </div>
                <div
                  class="flex justify-between text-xs font-bold tracking-wider text-zinc-500 uppercase dark:text-zinc-400"
                >
                  <span>Technical Distribution</span>
                  <span class="text-zinc-950 dark:text-zinc-50">12 Ready / 4 In Progress</span>
                </div>
              </div>
            </div>
            <div
              class="rounded border border-l-4 border-zinc-950/10 bg-white p-4 opacity-80 shadow-sm md:p-6 dark:border-white/10 dark:bg-zinc-900"
            >
              <div class="mb-4 flex items-start justify-between">
                <div>
                  <h4 class="font-heading text-lg font-bold text-zinc-950 dark:text-zinc-50">Infrastructure Core</h4>
                  <p class="text-sm text-zinc-500 dark:text-zinc-400">{content.infrastructureBody}</p>
                </div>
                <span
                  class="rounded bg-zinc-100 px-2 py-0.5 text-xs font-black tracking-wider text-zinc-500 uppercase dark:bg-zinc-800 dark:text-zinc-400"
                  >{content.infrastructureStatus}</span
                >
              </div>
              <div class="text-xs font-bold tracking-wider text-zinc-500 uppercase italic dark:text-zinc-400">
                {content.infrastructureNote}
              </div>
            </div>
          </div>
          <div class="space-y-3">
            <div
              class="rounded border border-zinc-950/10 bg-white p-4 shadow-sm md:p-6 dark:border-white/10 dark:bg-zinc-900"
            >
              <h5 class="mb-4 text-xs font-black tracking-widest text-zinc-500 uppercase dark:text-zinc-400">
                {content.insightsTitle}
              </h5>
              <div class="space-y-4">
                <div class="flex gap-3">
                  <div class="mt-1.5 h-1.5 w-1.5 rounded-full bg-red-600 dark:bg-red-500"></div>
                  <p class="text-xs font-bold text-zinc-950 dark:text-zinc-50">{content.insightsItems[0]}</p>
                </div>
                <div class="flex gap-3">
                  <div class="mt-1.5 h-1.5 w-1.5 rounded-full bg-blue-600 dark:bg-blue-500"></div>
                  <p class="text-xs font-bold text-zinc-950 dark:text-zinc-50">{content.insightsItems[1]}</p>
                </div>
              </div>
            </div>
            <div
              class="rounded border border-zinc-950/10 bg-white p-4 shadow-sm md:p-6 dark:border-white/10 dark:bg-zinc-900"
            >
              <h5 class="mb-4 text-xs font-black tracking-widest text-zinc-500 uppercase dark:text-zinc-400">
                {content.decisionsTitle}
              </h5>
              <div
                class="space-y-4 border-l-2 border-green-600/40 pl-3 text-zinc-950 dark:border-blue-400/40 dark:text-zinc-400"
              >
                <p class="text-xs leading-relaxed dark:text-zinc-400">
                  {firstDecisionParts.before}<span class="font-bold text-zinc-950 dark:text-zinc-50"
                    >{decisionHighlight}</span
                  >{firstDecisionParts.after}
                </p>
                <p class="text-xs leading-relaxed dark:text-zinc-400">{content.decisions[1]}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    id="methodology"
    class="border-y border-zinc-950/10 bg-zinc-50 py-8 md:py-12 dark:border-white/10 dark:bg-zinc-900"
  >
    <div class="mx-auto max-w-screen-2xl px-4 md:px-12">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
        {
          content.valueTitles.map((title, index) => (
            <div class="space-y-4 border-l-2 border-blue-600/40 pl-6 dark:border-blue-400/40">
              <h3 class="font-heading text-xl font-bold text-zinc-950 dark:text-zinc-50">{title}</h3>
              <p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{content.valueBodies[index]}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="mx-auto grid max-w-screen-2xl grid-cols-1 items-center gap-8 px-4 py-10 md:gap-12 md:px-12 md:py-16 lg:grid-cols-2"
  >
    <div class="space-y-4">
      <div
        class="inline-block rounded bg-green-100 px-2 py-1 text-xs font-black tracking-widest text-green-700 uppercase md:px-3 dark:bg-blue-400/20 dark:text-blue-400"
      >
        {content.contextWindow}
      </div>
      <h2
        class="font-heading text-3xl leading-tight font-extrabold tracking-tight text-zinc-950 md:text-4xl lg:text-5xl dark:text-zinc-50"
      >
        {content.detailTitle}
      </h2>
      <p class="text-base leading-relaxed text-zinc-500 md:text-lg dark:text-zinc-400">{content.detailBody}</p>
      <div class="space-y-2">
        <div
          class="flex items-center gap-3 rounded border border-l-4 border-blue-600 border-zinc-950/10 bg-zinc-50 p-3 md:gap-4 md:p-4 dark:border-blue-500 dark:border-white/10 dark:bg-zinc-900"
        >
          <span class="material-symbols-outlined text-blue-600 dark:text-blue-500">auto_graph</span>
          <span class="text-xs font-bold text-zinc-950 md:text-sm dark:text-zinc-50">{content.detailFeatures[0]}</span>
        </div>
        <div
          class="flex items-center gap-3 rounded border border-l-4 border-blue-600 border-zinc-950/10 bg-zinc-50 p-3 md:gap-4 md:p-4 dark:border-blue-500 dark:border-white/10 dark:bg-zinc-900"
        >
          <span class="material-symbols-outlined text-blue-600 dark:text-blue-500">terminal</span>
          <span class="text-xs font-bold text-zinc-950 md:text-sm dark:text-zinc-50">{content.detailFeatures[1]}</span>
        </div>
      </div>
    </div>
    <div class="relative">
      <div
        class="relative z-10 mx-auto max-w-lg rounded-lg border border-zinc-950/10 bg-white p-5 shadow-2xl md:p-8 dark:border-white/10 dark:bg-zinc-900"
      >
        <div class="mb-4 flex items-center justify-between border-b border-zinc-950/10 pb-2 dark:border-white/10">
          <span class="font-mono text-xs font-bold tracking-tighter text-zinc-500 uppercase dark:text-zinc-400"
            >TASK-442 / OPS</span
          >
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-xs text-blue-600 dark:text-blue-500">smart_toy</span>
            <span class="text-xs font-black tracking-tighter text-zinc-950 uppercase dark:text-zinc-50"
              >Agent Tracking</span
            >
          </div>
        </div>
        <h4 class="font-heading mb-2 text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
          {content.taskTitle}
        </h4>
        <p class="mb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
          {taskBodyParts.before}<span class="font-semibold text-blue-600 dark:text-blue-500">{content.taskAgent}</span>{
            taskBodyParts.after
          }
        </p>
        <div class="space-y-3">
          <div
            class="flex items-center justify-between rounded border border-blue-600/30 bg-blue-600/10 p-4 dark:border-blue-400/30 dark:bg-blue-400/10"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-lg text-blue-600 dark:text-blue-500">schema</span>
              <span class="text-xs font-bold tracking-wide text-zinc-950 uppercase dark:text-zinc-50"
                >{content.taskPrimary}</span
              >
            </div>
            <span class="text-xs font-bold text-blue-600 dark:text-blue-500">{content.taskPrimaryAction}</span>
          </div>
          <div
            class="flex items-center justify-between rounded border border-zinc-950/10 bg-zinc-50 p-4 dark:border-white/10 dark:bg-zinc-800"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-lg text-green-700 dark:text-green-400">verified</span>
              <span class="text-xs font-bold tracking-wide text-zinc-950 uppercase dark:text-zinc-50"
                >{content.taskSecondary}</span
              >
            </div>
            <span class="text-xs font-bold text-green-700 uppercase dark:text-green-400"
              >{content.taskSecondaryAction}</span
            >
          </div>
        </div>
      </div>
      <div
        class="absolute -top-6 -right-6 -z-10 h-full w-full rounded-xl bg-zinc-100 opacity-30 dark:bg-blue-500/5 dark:opacity-100"
      >
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-screen-2xl border-t border-zinc-950/10 px-4 py-10 md:px-12 md:py-16 dark:border-white/10"
  >
    <div class="flex flex-col items-start gap-8 md:flex-row">
      <div class="w-full md:w-1/3">
        <h2 class="font-heading text-3xl leading-tight font-extrabold tracking-tight text-zinc-950 dark:text-zinc-50">
          {content.systemTitle}
        </h2>
      </div>
      <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-2">
        {
          content.systemCards.map((card) => (
            <div class="rounded-lg border border-zinc-950/10 bg-zinc-50 p-8 shadow-md dark:border-white/10 dark:bg-zinc-900">
              <h4 class="font-heading mb-3 text-lg font-bold text-zinc-950 dark:text-zinc-50">{card.title}</h4>
              <p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-t border-zinc-950/10 bg-white px-4 py-10 text-center md:px-12 md:py-16 dark:border-white/10 dark:bg-zinc-950"
  >
    <div class="mx-auto max-w-3xl space-y-4">
      <h2
        class="font-heading text-3xl font-extrabold tracking-tight text-zinc-950 md:text-4xl lg:text-5xl dark:text-zinc-50"
      >
        {content.closingTitle}
      </h2>
      <p class="text-base text-zinc-500 md:text-xl dark:text-zinc-400">{content.closingBody}</p>
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row md:gap-4">
        <a
          href={appHref}
          class="w-full rounded-lg bg-blue-600 px-8 py-3 text-base font-bold text-white transition-all hover:bg-blue-700 sm:w-auto md:px-12 md:py-4 md:text-lg dark:bg-blue-500 dark:hover:bg-blue-400"
          >{content.closingPrimary}</a
        >
        <a
          href={appHref}
          class="w-full rounded-lg border border-zinc-950/20 px-8 py-3 text-base font-bold text-zinc-950 transition-all hover:bg-zinc-100 sm:w-auto md:px-12 md:py-4 md:text-lg dark:border-white/20 dark:text-zinc-50 dark:hover:bg-zinc-800"
          >{content.closingSecondary}</a
        >
      </div>
    </div>
  </section>
</main>

<footer
  class="w-full border-t border-zinc-950/10 bg-zinc-50 px-4 py-8 md:px-12 md:py-10 dark:border-white/10 dark:bg-zinc-900"
>
  <div class="mx-auto flex max-w-screen-2xl flex-col items-center justify-between gap-3 md:flex-row">
    <div class="font-sans text-xs font-bold tracking-widest text-zinc-500 uppercase dark:text-zinc-400">
      © 2024 THEMIS TECHNICAL LEDGER. ALL RIGHTS RESERVED.
    </div>
    <div class="flex gap-8">
      <a
        class="font-sans text-xs font-bold tracking-widest text-zinc-500 uppercase transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50"
        href="#">{content.footerLinks[0]}</a
      >
      <a
        class="font-sans text-xs font-bold tracking-widest text-zinc-500 uppercase transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50"
